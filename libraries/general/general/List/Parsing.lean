/-! ### Iterative list generation from a binary recurrence -/

/-- Iterate a binary function `f` for `k` steps, starting from `a, b`.
At each step, applies `f` to the current pair `(a, b)` producing the next value,
shifting `(a, b)` to `(b, f a b)`. Collected values are accumulated in reverse
and returned in forward order.

When called with `acc = []`, the result is a list of length `k` containing the
sequence generated by the recurrence `x_{i+2} = f x_i x_{i+1}` with initial
values `x_0 = a, x_1 = b`. That is, the result is `[a, b, f a b, f b (f a b), …]`.

For example, `iterHelper (· + ·) n 0 1 []` generates the first `n` Fibonacci numbers.
This generalizes `Nat.fibAux` (in `general/Fib.lean`) to arbitrary binary functions. -/
def iterHelper {α : Type} (f : α → α → α) (k : Nat) (a b : α) (acc : List α) : List α :=
  match k with
  | 0 => acc.reverse
  | k'+1 => iterHelper f k' b (f a b) (a :: acc)

/-! ### Stack utilities: `popWhile` and `popUntil` -/

/--
  Pop elements from the stack into the output list while the predicate `f` holds
  for the top element. Stops at the first element where `f` returns `false` or
  when the stack is empty.
-/
def popWhile (f : α → Bool) (stk out : List α) : List α × List α :=
  match stk with
  | [] => (stk, out)
  | top :: rest => if f top then popWhile f rest (out ++ [top]) else (stk, out)

/--
  Pop elements from the stack into the output list until the predicate `f` holds
  for the top element. When `f` holds, that element is discarded (not appended to
  `out`) and the remaining stack is returned. Stops at an empty stack without
  discarding anything.
-/
def popUntil (f : α → Bool) (stk out : List α) : List α × List α :=
  match stk with
  | [] => (stk, out)
  | top :: rest => if f top then (rest, out) else popUntil f rest (out ++ [top])

/-! ### Shunting Yard algorithm -/

/--
  Core Shunting Yard algorithm, parameterized by parenthesisation, operator
  recognition, and precedence comparison. This processes tokens into postfix
  (Reverse Polish Notation) order using a stack and an output queue.
-/
def shuntingCore (isLeftParen isRightParen isOperator : α → Bool)
    (shouldPopHigher : α → α → Bool) (tokens stk out : List α) : List α :=
  match tokens with
  | [] => out ++ stk.reverse
  | t :: rest =>
      if isLeftParen t then
        shuntingCore isLeftParen isRightParen isOperator shouldPopHigher rest (t :: stk) out
      else if isRightParen t then
        let (newStack, newOut) := popUntil isLeftParen stk out
        shuntingCore isLeftParen isRightParen isOperator shouldPopHigher rest newStack newOut
      else if isOperator t then
        let (stk', out') := popWhile (λ top => ¬ isLeftParen top ∧ shouldPopHigher top t) stk out
        shuntingCore isLeftParen isRightParen isOperator shouldPopHigher rest (t :: stk') out'
      else
        shuntingCore isLeftParen isRightParen isOperator shouldPopHigher rest stk (out ++ [t])

end List

namespace List

/-! ### Balanced delimiters -/

/-- `balancedAux openVal closeVal l cnt` holds if `l` is balanced with respect to
`openVal` and `closeVal`, assuming we are already at nesting depth `cnt`.
Values other than `openVal` / `closeVal` make the predicate false. -/
def balancedAux {α : Type} [DecidableEq α] (openVal closeVal : α) : List α → Nat → Prop
  | [], cnt => cnt = 0
  | c :: cs, cnt =>
      if c = openVal then
        balancedAux openVal closeVal cs (cnt + 1)
      else if c = closeVal then
        cnt > 0 ∧ balancedAux openVal closeVal cs (cnt - 1)
      else
        False

/-- A list is balanced with respect to `openVal` / `closeVal` when the nesting counter
returns to zero starting from depth 0. -/
def balanced {α : Type} [DecidableEq α] (openVal closeVal : α) (l : List α) : Prop :=
  balancedAux openVal closeVal l 0

/-- Boolean version of `balancedAux`: check if a list is balanced with respect to
`openVal` and `closeVal`, using an integer counter that must never go negative.
The counter starts at `cnt` and must return to 0 at the end.
Unlike the `Prop` version (`balancedAux`), this is computationally decidable
and returns a `Bool`. -/
def balancedAuxB {α : Type} [DecidableEq α] (openVal closeVal : α) : List α → Int → Bool
  | [], cnt => cnt == 0
  | a :: as, cnt =>
    let cnt' :=
      if a = openVal then cnt + 1
      else if a = closeVal then cnt - 1
      else cnt
    (0 ≤ cnt') && balancedAuxB openVal closeVal as cnt'

/-- Boolean version of `balanced`: check if a list is balanced with respect to
`openVal` and `closeVal` starting from depth 0. -/
def balancedB {α : Type} [DecidableEq α] (openVal closeVal : α) (l : List α) : Bool :=
  balancedAuxB openVal closeVal l 0

/-- Strict boolean version of `balancedAux`: check if a list is balanced with respect to
`openVal` and `closeVal`, using an integer counter that must never go negative.
The counter starts at `cnt` and must return to 0 at the end.

Unlike `balancedAuxB` (which silently ignores elements that are neither `openVal` nor
`closeVal`), this function returns `false` immediately upon encountering any such element.
This is the strict `Bool` counterpart to the strict `Prop`-valued `balancedAux`.

For balanced-bracket problems where the input must consist entirely of delimiters
(e.g., all characters are `'('` or `')'`), use this function to reject malformed input.
For mixed-content strings where non-delimiter characters should be ignored, use
`balancedAuxB` instead. -/
def balancedAuxStrict {α : Type} [DecidableEq α] (openVal closeVal : α) : List α → Int → Bool
  | [], cnt => cnt == 0
  | a :: as, cnt =>
      if a = openVal then
        balancedAuxStrict openVal closeVal as (cnt + 1)
      else if a = closeVal then
        (decide (cnt ≥ 1)) && balancedAuxStrict openVal closeVal as (cnt - 1)
      else
        false

/-- Strict boolean version of `balanced`: check if a list is balanced with respect to
`openVal` and `closeVal` starting from depth 0. Unlike `balancedB`, rejects any element
that is neither `openVal` nor `closeVal`. -/
def balancedStrict {α : Type} [DecidableEq α] (openVal closeVal : α) (l : List α) : Bool :=
  balancedAuxStrict openVal closeVal l 0

/-- Compute the net balance count of a list with respect to an opener and closer.
Each occurrence of `openVal` contributes `+1`, each `closeVal` contributes `-1`,
and all other values contribute `0`. This is a pure counting function that does
not perform any validity check — use `balancedB` when you also need to ensure the
count never drops below zero.

For example: `balanceCount '(' ')' ['(', '(', ')', ')'] = 0`. -/
def balanceCount {α : Type} [DecidableEq α] (openVal closeVal : α) (l : List α) : Int :=
  l.foldl (fun n x =>
    if x = openVal then n + 1
    else if x = closeVal then n - 1
    else n) 0

/-- Folding with the balance function starting from initial value `a` equals
`a + balanceCount openVal closeVal l`. This lemma is useful when reasoning about
balance computations with non-zero initial counters, e.g. when processing a list
incrementally. -/
lemma foldl_balanceCount_eq {α : Type} [DecidableEq α] (openVal closeVal : α) (l : List α)
    (a : Int) :
    List.foldl (fun (n : Int) (x : α) =>
      if x = openVal then n + 1
      else if x = closeVal then n - 1
      else n) a l =
    a + balanceCount openVal closeVal l := by
  unfold balanceCount
  induction' l with x l ih generalizing a
  · simp
  · simp [List.foldl]
    rw [ih (if x = openVal then a + 1 else if x = closeVal then a - 1 else a),
      ih (if x = openVal then 1 else if x = closeVal then -1 else 0)]
    by_cases hx_open : x = openVal
    · simp [hx_open]; rw [add_assoc]
    · by_cases hx_close : x = closeVal
      · by_cases h_eq : openVal = closeVal
        · exfalso; exact hx_open (h_eq.symm ▸ hx_close)
        · simp [hx_open, hx_close, Ne.symm h_eq]; rw [sub_eq_add_neg, add_assoc]
      · simp [hx_open, hx_close]

/-- Stack-based balanced-sequence validator parameterized by a classifier.
`classify c = none` means `c` is an opener (pushed onto the stack).
`classify c = some openChar` means `c` is a closer; the stack top must equal `openChar`.

Unlike `balancedB` which handles a single open/close pair with a counter,
`balancedFold` uses a stack and can handle multiple bracket types simultaneously
(e.g., `(`, `[`, `{` with their corresponding closers). -/
def balancedFold {α : Type} [DecidableEq α] (classify : α → Option α) : List α → List α → Bool
  | [], [] => true
  | [], _::_ => false
  | c :: cs, stk =>
    match classify c with
    | none => balancedFold classify cs (c :: stk)
    | some openChar =>
      match stk with
      | h :: stk' => if h = openChar then balancedFold classify cs stk' else false
      | [] => false

/-- Empty input with empty stack is balanced. -/

theorem balancedFold_nil_nil {α : Type} [DecidableEq α] (classify : α → Option α) :
    balancedFold classify [] [] = true :=
  rfl

/-- Empty input with a nonempty stack is always unbalanced. -/

theorem balancedFold_nil_cons {α : Type} [DecidableEq α] (classify : α → Option α)
    (h : α) (t : List α) : balancedFold classify [] (h :: t) = false :=
  rfl

/-- When `classify c = none` (opener), `c` is pushed and processing continues on `cs`. -/
theorem balancedFold_cons_opener {α : Type} [DecidableEq α] (classify : α → Option α)
    (c : α) (cs stk : List α) (h : classify c = none) :
    balancedFold classify (c :: cs) stk = balancedFold classify cs (c :: stk) := by
  simp [balancedFold, h]

/-- When `classify c = some openChar` and the stack top matches, both are consumed. -/
theorem balancedFold_cons_closer_match {α : Type} [DecidableEq α] (classify : α → Option α)
    (c openChar : α) (cs stk' : List α) (h : classify c = some openChar) :
    balancedFold classify (c :: cs) (openChar :: stk') = balancedFold classify cs stk' := by
  simp [balancedFold, h]

/-- When `classify c = some openChar` but the stack is empty, the sequence is unbalanced. -/
theorem balancedFold_cons_closer_empty_stack {α : Type} [DecidableEq α] (classify : α → Option α)
    (c openChar : α) (cs : List α) (h : classify c = some openChar) :
    balancedFold classify (c :: cs) [] = false := by
  simp [balancedFold, h]

/-! ### Balanced with wildcard -/

/-- Auxiliary function for checking whether a list of characters can be balanced
when a wildcard character can be interpreted as open, close, or empty.
Tracks the minimum (`low`) and maximum (`high`) possible numbers of unmatched
`openChar` characters.

The algorithm is:
- On `openChar`: both `low` and `high` increase by 1.
- On `closeChar`: if `high = 0`, the sequence is impossible. Otherwise,
  `low` decreases by 1 (but not below 0) and `high` decreases by 1.
- On `wildcard`: treat as `closeChar` for `low` (decrease but not below 0),
  treat as `openChar` for `high` (increase by 1).
- Any other character makes the result `false`.

The list can be balanced iff `low = 0` at the end. -/
def balancedWildcardAux (openChar closeChar wildcard : Char) : List Char → Nat → Nat → Bool
  | [], low, _ => decide (low = 0)
  | c :: cs, low, high =>
    if c = openChar then
      balancedWildcardAux openChar closeChar wildcard cs (low + 1) (high + 1)
    else if c = closeChar then
      if high = 0 then false
      else
        let low' := if low = 0 then 0 else low - 1
        balancedWildcardAux openChar closeChar wildcard cs low' (high - 1)
    else if c = wildcard then
      let low' := if low = 0 then 0 else low - 1
      balancedWildcardAux openChar closeChar wildcard cs low' (high + 1)
    else
      false

/-- Check whether a list of characters can be a balanced parenthesis string
when each `*` can represent `(`, `)`, or empty.
This is the entry point for the wildcard-balanced validation starting from
depth 0 with both `low` and `high` counters at 0. -/
def parenthesisWildcardBalanced (l : List Char) : Bool :=
  balancedWildcardAux '(' ')' '*' l 0 0

end List


namespace List

/-! # `splitWordsBy` — split a `List Char` into words by a predicate

`splitWordsBy p cs` groups maximal consecutive characters satisfying `p` into
words (as `String`s), discarding characters that do not satisfy `p` (delimiters).

This is the `List Char → List String` specialization of `groupByConsecutive`:
`splitWordsBy p cs = (groupByConsecutive p cs).map String.mk`.
The direct implementation here is a single-pass tail-recursive fold
for efficiency.
-/

/-- Split a list of characters into words, using `p` to decide which characters
are word characters. Non-word characters serve as delimiters.

For example:
* `splitWordsBy Char.isAlpha ['h','e','l','l','o',' ','w','o','r','l','d'] = ["hello", "world"]`
* `splitWordsBy Char.isDigit ['1','2','a','3','4'] = ["12", "34"]`
* `splitWordsBy (· ·) [] = []` -/
def splitWordsBy (p : Char → Bool) (cs : List Char) : List String :=
  let rec go (cs : List Char) (cur : List Char) (acc : List String) : List String :=
    match cs with
    | [] =>
        let acc' :=
          if cur = [] then acc
          else (String.mk (List.reverse cur)) :: acc
        List.reverse acc'
    | c :: cs' =>
        if p c then
          go cs' (c :: cur) acc
        else
          let acc' :=
            if cur = [] then acc
            else (String.mk (List.reverse cur)) :: acc
          go cs' [] acc'
  go cs [] []


theorem splitWordsBy_nil (p : Char → Bool) : splitWordsBy p [] = [] :=
  rfl

/-- `splitWordsBy` is equivalent to grouping consecutive satisfying elements
and converting each group to a `String`. -/
theorem splitWordsBy_eq_map_mk_groupByConsecutive (p : Char → Bool) (cs : List Char) :
    splitWordsBy p cs = (groupByConsecutive p cs).map String.mk := by
  have aux (l cur : List Char) (acc : List String) :
      splitWordsBy.go p l cur acc = acc.reverse ++ (splitByPred p l cur).map String.mk := by
    induction l generalizing cur acc with
    | nil =>
      by_cases h : cur = []
      · simp [splitWordsBy.go, splitByPred, h]
      · have hr : cur.reverse ≠ [] := by simpa using h
        simp [splitWordsBy.go, splitByPred, h, hr]
    | cons c cs ih =>
      by_cases hp : p c = true
      · simp [splitWordsBy.go, splitByPred, hp, ih]
      · by_cases h : cur = []
        · simp [splitWordsBy.go, splitByPred, hp, h, ih]
        · have hr : cur.reverse ≠ [] := by simpa using h
          simp [splitWordsBy.go, splitByPred, hp, h, hr, ih, List.append_assoc]
  simpa [splitWordsBy, groupByConsecutive] using aux cs [] []

end List
